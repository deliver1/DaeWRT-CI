#!/bin/sh /etc/rc.common
# honk-core - transparent proxy (daeuniverse honk-core), auto-start at boot.
# Official OpenWrt procd service (daeuniverse.org/doona/service-management).
# Config: /etc/honk/config.dae (default: all-direct, Doona for nodes).
# Doona web UI: http://192.168.10.1:9527 (change the secret in /etc/honk/native_api.dae first).
# Requires bpffs mounted (START=10) before honk-core starts.
START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/bin/honk-core ] || return 1
	[ -f /etc/honk/config.dae ] || return 1
	mkdir -p /etc/honk/data
	procd_open_instance
	procd_set_param command /usr/bin/honk-core --config /etc/honk/config.dae --data-dir /etc/honk/data --disable-timestamp
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param env MIMALLOC_PURGE_DELAY=0
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/bin/honk-core reload
}
