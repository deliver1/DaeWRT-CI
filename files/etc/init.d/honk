#!/bin/sh /etc/rc.common
# honk - transparent proxy (daeuniverse honk-core), auto-start at boot.
# Installed by DaeWRT-CI 618-v2b (honk baked in). Config: /etc/honk/config.dae.
# Doona web UI: http://192.168.10.1:9527 (change the secret in /etc/honk/native_api.dae first).
# Requires bpffs mounted (START=10) before honk starts.
START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/bin/honk-core ] || return 1
	[ -f /etc/honk/config.dae ] || return 1
	mkdir -p /tmp/honk
	procd_open_instance
	procd_set_param command /usr/bin/honk-core --config /etc/honk/config.dae
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
